# Copy to .env and fill in. Empty values fall back to defaults.

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Your personal chat id (run the bot, send /start, it replies with the id)
TELEGRAM_CHAT_ID=

# ── Schedule ────────────────────────────────────────────────
# IANA timezone, e.g. Asia/Seoul. Empty = system local timezone
TIMEZONE=
# time=slot pairs; slots: morning | midday | evening
SCHEDULE=09:00=morning,14:00=midday,21:00=evening
LMS_POLL_MINUTES=60

# ── LLM ─────────────────────────────────────────────────────
# openai | gemini | none  (none = template digest without LLM, good for testing)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
DIGEST_LANGUAGE=ru
DIGEST_MAX_WORDS=380

# ── Jobs ────────────────────────────────────────────────────
# Remote-job RSS feeds work without any key:
# JOB_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss,https://himalayas.app/jobs/rss
JOB_FEEDS_LOOKBACK_DAYS=7

# HH.ru: since April 2026 the API needs an application token (register an app at https://dev.hh.ru).
# Without a token HH.ru is skipped.
HH_ENABLED=true
HH_APP_TOKEN=
HH_QUERY=machine learning OR data scientist OR ML engineer OR MLOps OR python backend
# area ids: 113 = Russia, 40 = Kazakhstan, 1 = Moscow; empty = everywhere
HH_AREA=
# noExperience | between1And3 | between3And6 | moreThan6; empty = any
HH_EXPERIENCE=
HH_REMOTE_ONLY=false
# Case-insensitive regexes applied to the vacancy title (defaults in app/config.py)
# JOB_INCLUDE=
# JOB_EXCLUDE=
JOBS_MAX=5

# ── News (RSS) ──────────────────────────────────────────────
# NEWS_FEEDS=https://huggingface.co/blog/feed.xml,https://openai.com/news/rss.xml
NEWS_MAX=5
NEWS_LOOKBACK_HOURS=36

# ── LMS watcher ─────────────────────────────────────────────
# Comma-separated instance names; each needs LMS_<NAME>_KIND and LMS_<NAME>_URL
LMS_INSTANCES=smart,nsmart
LMS_HEADLESS=true

# Woosong University e-learning (Moodle). Selectors verified with `python -m app lms-probe smart`.
LMS_SMART_KIND=moodle
LMS_SMART_URL=https://smart.wsu.ac.kr
LMS_SMART_USERNAME_SELECTOR=#iuser_id
LMS_SMART_PASSWORD_SELECTOR=#iuser_password
LMS_SMART_SUBMIT_SELECTOR=button:has-text("로그인"):visible
# Students log in via university SSO: click 'SSO login', then the 'student ID login' tab
LMS_SMART_PRE_LOGIN_CLICKS=a.btn-login-type-sso|text=학번/교번 로그인
# Fill these for unattended re-login when the session expires (optional; otherwise use lms-login)
LMS_SMART_USERNAME=
LMS_SMART_PASSWORD=

# Woosong University nSmart (Canvas). Selectors verified with `python -m app lms-probe nsmart`.
LMS_NSMART_KIND=canvas
LMS_NSMART_URL=https://nsmart.wsu.ac.kr
LMS_NSMART_USERNAME_SELECTOR=#pseudonym_session_unique_id
LMS_NSMART_PASSWORD_SELECTOR=#pseudonym_session_password
LMS_NSMART_SUBMIT_SELECTOR=input[name=commit]
LMS_NSMART_USERNAME=
LMS_NSMART_PASSWORD=
# Optional Canvas API token (Account → Settings → New Access Token) — the most robust option if allowed
LMS_NSMART_TOKEN=
